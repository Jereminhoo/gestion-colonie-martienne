<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0" >
    <persistence-unit name="colonie-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Tu ajouteras tes classes ici plus tard, comme ça : -->
        <!-- <class>be.condorcet.gestioncoloniemartienne.model.MembreEquipage</class> -->

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="oracle.jdbc.OracleDriver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:oracle:thin:@mons-oracle19.condorcet.be:1521:orcl"/>
            <property name="jakarta.persistence.jdbc.user" value="ORA23"/>
            <property name="jakarta.persistence.jdbc.password" value="oracle"/>

            <property name="hibernate.dialect" value="org.hibernate.dialect.OracleDialect"/>

            <!-- Attention : "drop-and-create" vide la table à chaque redémarrage. -->
            <!-- Passe à "update" quand tu voudras garder tes données. -->
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>

            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

        </properties>
    </persistence-unit>
</persistence>