<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="colonie-pu" transaction-type="JTA">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Datasource Oracle déclarée dans WildFly -->
        <jta-data-source>java:jboss/datasources/ColonieDS</jta-data-source>

        <!-- Entités -->
        <class>be.condorcet.gestioncoloniemartienne.model.MembreEquipage</class>
        <class>be.condorcet.gestioncoloniemartienne.model.Ressource</class>

        <properties>

            <!-- Dialect Oracle -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.OracleDialect"/>

            <!-- Gestion du schéma -->
            <!-- update = safe pour le projet -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>

            <!-- Logs SQL -->
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>

        </properties>
    </persistence-unit>
</persistence>
